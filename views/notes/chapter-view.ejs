<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/notes.css">

<div class="notes-watermark">SA METHOD</div>

<div class="notes-container">
  <header class="notes-header">
    <div class="badges">
      <span class="badge teal"><%= chapter.subject %></span>
      <span class="badge gold"><%= chapter.category %></span>
    </div>
    <h1><%= chapter.title %></h1>
  </header>

  <article class="notes-content">
    <%- chapter.processedHtml %>
  </article>
</div>

<%- include('../partials/footer') %>