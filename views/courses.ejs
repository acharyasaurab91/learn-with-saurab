<%- include('partials/header') %>

<div class="page-hero page-hero-sm">
  <div class="container">
    <h1>Browse <span class="gradient-text">Courses</span></h1>
    <p>Find the perfect course for your exam preparation</p>
  </div>
</div>

<div class="courses-page container">
  <div class="courses-filters">
    <form method="GET" action="/browse-courses" id="filterForm">
      <div class="filter-bar">
        <div class="search-wrap">
          <i class="fas fa-search"></i>
          <input type="text" name="search" placeholder="Search courses..." value="<%= query.search || '' %>">
        </div>
        <select name="category" onchange="this.form.submit()">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.slug %>" <%= query.category === cat.slug ? 'selected' : '' %>><%= cat.name %></option>
          <% }) %>
        </select>
        <select name="examType" onchange="this.form.submit()">
          <option value="">All Exam Types</option>
          <optgroup label="── CEE ──">
            <option value="CEE - Medical & Paramedical" <%= query.examType === 'CEE - Medical & Paramedical' ? 'selected' : '' %>>CEE — Medical & Paramedical (MBBS, BDS, BSc Nursing, B.Pharmacy)</option>
            <option value="CEE - BNS (B.N.Sc.)" <%= query.examType === 'CEE - BNS (B.N.Sc.)' ? 'selected' : '' %>>CEE — BNS (Bachelor of Nursing Science)</option>
          </optgroup>
          <optgroup label="── IOE ──">
            <option value="IOE - Engineering" <%= query.examType === 'IOE - Engineering' ? 'selected' : '' %>>IOE — Engineering (BE, B.Arch, BEI)</option>
          </optgroup>
          <optgroup label="── Loksewa ──">
            <option value="Loksewa / लोकसेवा" <%= query.examType === 'Loksewa / लोकसेवा' ? 'selected' : '' %>>Loksewa / लोकसेवा (PSC)</option>
          </optgroup>
          <optgroup label="── License Exams ──">
            <option value="Nursing License (NLEN)" <%= query.examType === 'Nursing License (NLEN)' ? 'selected' : '' %>>Nursing License Exam (NNC)</option>
            <option value="CMLT License" <%= query.examType === 'CMLT License' ? 'selected' : '' %>>CMLT License Exam (NHPC)</option>
            <option value="Pharmacy License" <%= query.examType === 'Pharmacy License' ? 'selected' : '' %>>Pharmacy License Exam (NPC)</option>
            <option value="HA License" <%= query.examType === 'HA License' ? 'selected' : '' %>>HA License Exam (NHPC)</option>
          </optgroup>
          <optgroup label="── SEE & NEB ──">
            <option value="SEE (Grade 10)" <%= query.examType === 'SEE (Grade 10)' ? 'selected' : '' %>>SEE — Grade 10</option>
            <option value="Grade 11" <%= query.examType === 'Grade 11' ? 'selected' : '' %>>Grade 11 (NEB)</option>
            <option value="Grade 12" <%= query.examType === 'Grade 12' ? 'selected' : '' %>>Grade 12 (NEB)</option>
          </optgroup>
        </select>
        <select name="priceFilter" onchange="this.form.submit()">
          <option value="">All Prices</option>
          <option value="free" <%= query.priceFilter === 'free' ? 'selected' : '' %>>Free</option>
          <option value="paid" <%= query.priceFilter === 'paid' ? 'selected' : '' %>>Paid</option>
        </select>
        <button type="submit" class="btn-filter"><i class="fas fa-filter"></i> Filter</button>
        <a href="/browse-courses" class="btn-clear"><i class="fas fa-times"></i> Clear</a>
      </div>
    </form>
  </div>

  <div class="courses-results">
    <p class="results-count">
      <% if (query.search || query.category || query.examType) { %>
        <i class="fas fa-filter" style="color:var(--color-teal)"></i>
        <%= courses.length %> course<%= courses.length !== 1 ? 's' : '' %> found
        <% if (query.search) { %> for "<strong><%= query.search %></strong>"<% } %>
      <% } else { %>
        Showing all <%= courses.length %> course<%= courses.length !== 1 ? 's' : '' %>
      <% } %>
    </p>
    <% if (courses.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-search"></i>
        <h3>No courses found</h3>
        <p>Try adjusting your filters or <a href="/browse-courses">view all courses</a></p>
      </div>
    <% } else { %>
    <div class="courses-grid courses-grid-wide">
      <% courses.forEach((course, i) => { %>
      <div class="course-card" data-gsap="fade-up" data-delay="<%= (i % 4) * 0.1 %>">
        <div class="course-img-wrap">
          <% if (course.imageUrl) { %>
            <img src="<%= course.imageUrl %>" alt="<%= course.title %>" loading="lazy">
          <% } else { %>
            <div class="course-img-placeholder"><i class="fas fa-book-open"></i></div>
          <% } %>
          <div class="course-badge" style="text-transform:none"><%= course.examType || course.category || 'Course' %></div>
          <% if (course.isFeatured) { %><div class="course-featured-badge"><i class="fas fa-star"></i> Featured</div><% } %>
          <% if (course.demoVideoUrl) { %>
            <div style="position:absolute;bottom:10px;right:10px;background:rgba(31,106,92,0.92);backdrop-filter:blur(8px);border-radius:6px;padding:3px 10px;font-size:10px;font-weight:700;color:#fff">
              <i class="fas fa-play"></i> Demo
            </div>
          <% } %>
        </div>
        <div class="course-body">
          <h3 class="course-title"><%= course.title %></h3>
          <p class="course-desc"><%= (course.description || '').substring(0, 90) %>...</p>
          <div class="course-meta">
            <span><i class="fas fa-users"></i> <%= course.enrolledCount || 0 %> enrolled</span>
            <% if (course.duration) { %><span><i class="fas fa-clock"></i> <%= course.duration %>h</span><% } %>
            <% if (course.totalRatings > 0) { %><span><i class="fas fa-star" style="color:#B9852D"></i> <%= course.rating.toFixed(1) %></span><% } %>
          </div>
          <% if (course.targetPrograms && course.targetPrograms.length > 0) { %>
          <div style="margin-bottom:12px;display:flex;flex-wrap:wrap;gap:4px">
            <% course.targetPrograms.forEach(p => { %>
              <span style="background:rgba(14,124,114,0.1);color:#0E7C72;padding:2px 8px;border-radius:50px;font-size:11px;font-weight:700"><%= p %></span>
            <% }) %>
          </div>
          <% } %>
          <% if (course.stream) { %>
          <div style="margin-bottom:12px">
            <span style="background:rgba(58,106,138,0.1);color:#3A6A8A;padding:2px 8px;border-radius:50px;font-size:11px;font-weight:700"><%= course.stream %> Stream</span>
          </div>
          <% } %>
          <div class="course-footer">
            <div class="course-price">
              <% if (course.price === 0) { %>
                <span class="price-free">FREE</span>
              <% } else { %>
                <span class="price-amount">Rs. <%= course.price.toLocaleString() %></span>
              <% } %>
            </div>
            <a href="/courses/<%= course._id %>" class="btn-enroll">
              <span>View</span><i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
