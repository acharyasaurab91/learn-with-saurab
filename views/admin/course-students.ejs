<%- include('../partials/header', { extraCss: '<link rel="stylesheet" href="/css/admin.css">' }) %>
<div class="admin-layout">
  <%- include('./partials/sidebar', { activePage: 'courses' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <h1><i class="fas fa-users"></i> Students in <span class="text-teal"><%= course.title %></span></h1>
      <div class="topbar-actions">
        <a href="/admin/courses/<%= course._id %>/modules" class="btn-secondary"><i class="fas fa-layer-group"></i> Module Builder</a>
        <a href="/admin/courses" class="btn-secondary"><i class="fas fa-arrow-left"></i> Back to Courses</a>
      </div>
    </div>

    <!-- Course summary -->
    <div class="admin-section course-summary">
      <div class="cs-thumb">
        <% if (course.imageUrl) { %>
          <img src="<%= course.imageUrl %>" alt="<%= course.title %>">
        <% } else { %>
          <i class="fas fa-book-open"></i>
        <% } %>
      </div>
      <div class="cs-info">
        <h2><%= course.title %></h2>
        <div class="cs-meta">
          <span class="badge-blue"><%= course.category || 'No category' %></span>
          <span class="badge-green"><%= course.price === 0 ? 'FREE' : 'Rs. ' + course.price.toLocaleString() %></span>
          <span class="badge-gray"><%= rows.length %> student<%= rows.length === 1 ? '' : 's' %></span>
          <span class="badge-yellow"><%= total %> lesson<%= total === 1 ? '' : 's' %></span>
          <span class="badge-blue">Avg progress: <%= avgPct %>%</span>
        </div>
      </div>
    </div>

    <!-- Roster -->
    <div class="admin-section" style="margin-top:22px">
      <div class="admin-section-header">
        <h2><i class="fas fa-user-graduate"></i> Roster</h2>
        <span class="badge-blue"><%= rows.length %> enrolled</span>
      </div>
      <% if (rows.length === 0) { %>
        <div class="empty-state-sm"><i class="fas fa-user-graduate"></i><p>No students enrolled in this course yet.</p></div>
      <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Progress</th>
            <th>Lessons Completed</th>
            <th>Tests Taken</th>
            <th>Enrolled</th>
            <th>Last Activity</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(r => { %>
          <tr>
            <td>
              <strong><%= r.student.firstName %> <%= r.student.lastName %></strong><br>
              <span class="text-muted text-sm"><%= r.student.email %></span>
            </td>
            <td>
              <div class="prog-cell">
                <strong><%= r.pct %>%</strong>
                <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width:<%= r.pct %>%"></div></div>
              </div>
            </td>
            <td><%= r.done %> / <%= total %> lesson<%= total === 1 ? '' : 's' %></td>
            <td><%= r.tests %><%= r.tests ? ' · avg ' + r.avgScore + '%' : '' %></td>
            <td><%= r.enrolledAt ? new Date(r.enrolledAt).toLocaleDateString() : 'Unknown' %></td>
            <td><%= r.lastActivity ? new Date(r.lastActivity).toLocaleString() : '—' %></td>
            <td class="actions-cell">
              <a href="/admin/student/<%= r.student._id %>" class="btn-icon btn-blue" title="View progress"><i class="fas fa-eye"></i></a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
