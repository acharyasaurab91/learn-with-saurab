<%- include('../partials/header', { extraCss: '<link rel="stylesheet" href="/css/admin.css">' }) %>
<div class="admin-layout">
  <%- include('./partials/sidebar', { activePage: 'students' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <h1><i class="fas fa-user-graduate"></i> Students</h1>
      <div class="topbar-actions">
        <a href="/admin/users" class="btn-secondary"><i class="fas fa-users-cog"></i> Manage Users</a>
        <span class="badge-blue"><%= users.length %> student<%= users.length === 1 ? '' : 's' %></span>
      </div>
    </div>

    <div class="admin-section">
      <form method="GET" class="admin-search-bar">
        <input type="text" name="search" placeholder="Search by name, username or email..." value="<%= query.search || '' %>">
        <button type="submit" class="btn-admin-primary"><i class="fas fa-search"></i></button>
      </form>

      <% if (users.length === 0) { %>
        <div class="empty-state-sm"><i class="fas fa-user-graduate"></i><p>No students found<%= query.search ? ' for that search' : ' yet' %>.</p></div>
      <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Enrolled</th>
            <th>Videos Completed</th>
            <th>Tests Taken</th>
            <th>Avg Score</th>
            <th>Last Active</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { const s = stats[u._id] || { tests: 0, avg: 0, done: 0, last: null }; %>
          <tr>
            <td>
              <strong><%= u.firstName %> <%= u.lastName %></strong><br>
              <span class="text-muted text-sm"><%= u.email %> · @<%= u.username %></span>
            </td>
            <td><span class="badge-blue"><%= u.enrolledCourses.length %> course<%= u.enrolledCourses.length === 1 ? '' : 's' %></span></td>
            <td><%= s.done %></td>
            <td><%= s.tests %></td>
            <td><%= s.tests ? s.avg + '%' : '—' %></td>
            <td><%= s.last ? new Date(s.last).toLocaleString() : '—' %></td>
            <td class="actions-cell">
              <a href="/admin/student/<%= u._id %>" class="btn-icon btn-blue" title="View progress"><i class="fas fa-eye"></i></a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
