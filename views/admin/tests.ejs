<%- include('../partials/header', { extraCss: '<link rel="stylesheet" href="/css/admin.css">' }) %>
<div class="admin-layout">
  <%- include('./partials/sidebar', { activePage: 'tests' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <h1><i class="fas fa-clipboard-list"></i> Test Manager</h1>
      <a href="/admin/tests/new" class="btn-admin-primary"><i class="fas fa-plus"></i> New Test</a>
    </div>
    <div class="admin-section">
      <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= flash.success %></div>
      <% } %>
      <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= flash.error %></div>
      <% } %>

      <% if (tests.length === 0) { %>
        <div class="empty-state"><i class="fas fa-clipboard-list"></i><h3>No tests yet</h3><p>Create your first test.</p></div>
      <% } else { %>
      <div class="tests-toolbar">
        <input type="text" id="testSearch" class="tests-search" placeholder="Search by title...">
        <div class="tests-filters" id="testFilters">
          <button type="button" class="tf-btn active" data-filter="all">All</button>
          <button type="button" class="tf-btn" data-filter="published">Published</button>
          <button type="button" class="tf-btn" data-filter="draft">Draft</button>
        </div>
      </div>
      <table class="data-table" id="testsTable">
        <thead>
          <tr>
            <th>Title</th><th>Category</th><th>Questions</th><th>Duration</th>
            <th>Marks</th><th>Published</th><th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% tests.forEach(t => { const qc = t.questions ? t.questions.length : 0;
             const computed = t.questions ? t.questions.reduce((s, q) => s + (q.marks || 1), 0) : 0; %>
          <tr data-title="<%= t.title.toLowerCase() %>" data-published="<%= t.isPublished %>">
            <td><strong><%= t.title %></strong> <% if (t.isFree) { %><span class="badge-blue">Free</span><% } %></td>
            <td><%= t.category || '—' %></td>
            <td><%= qc %></td>
            <td><%= t.duration %> min</td>
            <td><%= t.totalMarks || computed || '—' %></td>
            <td>
              <label class="pub-toggle" title="<%= t.isPublished ? 'Published — click to unpublish' : 'Draft — click to publish' %>">
                <input type="checkbox" <%= t.isPublished ? 'checked' : '' %> onchange="togglePublish('<%= t._id %>', this)">
                <span class="pub-slider"></span>
              </label>
            </td>
            <td class="actions-cell">
              <a href="/admin/tests/<%= t._id %>/questions" class="btn-icon btn-blue" title="Questions"><i class="fas fa-question-circle"></i></a>
              <a href="/admin/tests/<%= t._id %>/edit" class="btn-icon btn-edit" title="Edit"><i class="fas fa-edit"></i></a>
              <button type="button" data-id="<%= t._id %>" data-title="<%= t.title %>" onclick="deleteTest(this)" class="btn-icon btn-delete" title="Delete"><i class="fas fa-trash"></i></button>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="text-muted text-sm" id="noTests" style="display:none">No tests match your search.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer', { extraJs: `<script>
(function () {
  var activeFilter = 'all';
  var search = document.getElementById('testSearch');
  var filters = document.getElementById('testFilters');

  function applyFilters() {
    var q = search ? search.value.toLowerCase() : '';
    var visible = 0;
    document.querySelectorAll('#testsTable tbody tr').forEach(function (row) {
      var matchQ = (row.dataset.title || '').indexOf(q) !== -1;
      var matchF = activeFilter === 'all' ||
        (activeFilter === 'published' && row.dataset.published === 'true') ||
        (activeFilter === 'draft' && row.dataset.published === 'false');
      var show = matchQ && matchF;
      row.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    var empty = document.getElementById('noTests');
    if (empty) empty.style.display = visible ? 'none' : 'block';
  }

  if (search) search.addEventListener('input', applyFilters);
  if (filters) filters.addEventListener('click', function (e) {
    var btn = e.target.closest('button[data-filter]');
    if (!btn) return;
    filters.querySelectorAll('.tf-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    activeFilter = btn.dataset.filter;
    applyFilters();
  });
})();

async function togglePublish(id, el) {
  try {
    var res = await fetch('/admin/tests/' + id + '/publish', { method: 'POST' });
    var data = await res.json();
    if (!data.success) throw new Error(data.message || 'failed');
    el.closest('label').title = data.isPublished ? 'Published — click to unpublish' : 'Draft — click to publish';
  } catch (err) {
    alert('Could not update publish state.');
    el.checked = !el.checked;
  }
}

function deleteTest(el) {
  if (!confirm('Delete test "' + el.dataset.title + '"? This also removes its questions.')) return;
  var form = document.createElement('form');
  form.method = 'POST';
  form.action = '/admin/tests/' + el.dataset.id + '/delete';
  document.body.appendChild(form);
  form.submit();
}
</script>` }) %>
