<%- include('../partials/header', { extraCss: '<link rel="stylesheet" href="/css/admin.css">' }) %>

<div class="admin-layout">
  <%- include('./partials/sidebar', { activePage: 'dashboard' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1><i class="fas fa-th-large"></i> Admin Dashboard</h1>
        <p style="color:#6B7280;font-size:13px;margin-top:2px">Welcome back, <%= admin.firstName %> — Manage Learn With Saurab</p>
      </div>
      <div class="topbar-actions">
        <a href="/admin/courses/new" class="btn-admin-primary"><i class="fas fa-plus"></i> New Course</a>
        <a href="/" target="_blank" class="btn-secondary" style="padding:10px 16px;font-size:13px"><i class="fas fa-external-link-alt"></i> View Site</a>
        <a href="/logout" class="btn-secondary btn-danger" style="padding:10px 16px;font-size:13px"><i class="fas fa-sign-out-alt"></i> Logout</a>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="admin-stats-grid">
      <div class="admin-stat-card asc-blue">
        <div class="asc-icon"><i class="fas fa-users"></i></div>
        <div class="asc-body">
          <div class="asc-num"><%= stats.users.toLocaleString() %></div>
          <div class="asc-label">Total Students</div>
        </div>
      </div>
      <div class="admin-stat-card asc-purple">
        <div class="asc-icon"><i class="fas fa-book-open"></i></div>
        <div class="asc-body">
          <div class="asc-num"><%= stats.courses %></div>
          <div class="asc-label">Total Courses</div>
        </div>
      </div>
      <div class="admin-stat-card asc-yellow">
        <div class="asc-icon"><i class="fas fa-clipboard-list"></i></div>
        <div class="asc-body">
          <div class="asc-num"><%= stats.tests %></div>
          <div class="asc-label">Practice Tests</div>
        </div>
      </div>
      <div class="admin-stat-card asc-green">
        <div class="asc-icon"><i class="fas fa-coins"></i></div>
        <div class="asc-body">
          <div class="asc-num">Rs. <%= stats.revenue.toLocaleString() %></div>
          <div class="asc-label">Total Revenue</div>
        </div>
      </div>
    </div>

    <!-- Chart + Quick Actions -->
    <div class="admin-grid-2">
      <div class="admin-section">
        <div class="admin-section-header">
          <h2><i class="fas fa-chart-line" style="color:#00D4FF"></i> Student Signups (Last 30 Days)</h2>
        </div>
        <div class="chart-wrap"><canvas id="signupChart"></canvas></div>
      </div>
      <div class="admin-section">
        <div class="admin-section-header">
          <h2><i class="fas fa-bolt" style="color:#F59E0B"></i> Quick Actions</h2>
        </div>
        <div class="quick-actions-grid">
          <a href="/admin/courses/new" class="qa-btn">
            <i class="fas fa-plus-circle" style="color:#00D4FF"></i>
            <span>New Course</span>
          </a>
          <a href="/admin/tests" class="qa-btn">
            <i class="fas fa-clipboard-list" style="color:#7C3AED"></i>
            <span>New Test</span>
          </a>
          <a href="/admin/categories" class="qa-btn">
            <i class="fas fa-tags" style="color:#F59E0B"></i>
            <span>Categories</span>
          </a>
          <a href="/admin/users" class="qa-btn">
            <i class="fas fa-users" style="color:#10B981"></i>
            <span>Users</span>
          </a>
          <a href="/admin/transactions" class="qa-btn">
            <i class="fas fa-money-bill-wave" style="color:#EC4899"></i>
            <span>Payments</span>
          </a>
          <a href="/admin/demo-lectures" class="qa-btn">
            <i class="fas fa-play-circle" style="color:#EF4444"></i>
            <span>Demo Lectures</span>
          </a>
          <a href="/admin/reviews" class="qa-btn">
            <i class="fas fa-star" style="color:#F59E0B"></i>
            <span>Reviews</span>
          </a>
          <a href="/admin/analytics" class="qa-btn">
            <i class="fas fa-chart-bar" style="color:#8B5CF6"></i>
            <span>Analytics</span>
          </a>
          <a href="/free-tests" target="_blank" class="qa-btn">
            <i class="fas fa-external-link-alt" style="color:#6B7280"></i>
            <span>View Tests</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Students + Payments -->
    <div class="admin-grid-2">
      <div class="admin-section">
        <div class="admin-section-header">
          <h2><i class="fas fa-users" style="color:#00D4FF"></i> Recent Students</h2>
          <a href="/admin/users" class="btn-secondary" style="font-size:12px;padding:6px 12px">View All</a>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>Name</th><th>Email</th><th>Joined</th></tr></thead>
            <tbody>
              <% recentUsers.forEach(u => { %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#00D4FF,#7C3AED);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800;color:#fff;flex-shrink:0">
                      <%= (u.firstName || 'U')[0].toUpperCase() %>
                    </div>
                    <strong><%= u.firstName %> <%= u.lastName %></strong>
                  </div>
                </td>
                <td style="color:#9CA3AF;font-size:13px"><%= u.email %></td>
                <td style="color:#9CA3AF;font-size:12px"><%= new Date(u.createdAt).toLocaleDateString('en-US', { day: 'numeric', month: 'short' }) %></td>
              </tr>
              <% }) %>
              <% if (!recentUsers.length) { %>
              <tr><td colspan="3" class="empty-state-sm"><i class="fas fa-users"></i><p>No students yet</p></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="admin-section">
        <div class="admin-section-header">
          <h2><i class="fas fa-money-bill-wave" style="color:#10B981"></i> Recent Payments</h2>
          <a href="/admin/transactions" class="btn-secondary" style="font-size:12px;padding:6px 12px">View All</a>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th>Student</th><th>Course</th><th>Amount</th></tr></thead>
            <tbody>
              <% recentTxns.forEach(t => { %>
              <tr>
                <td style="font-size:13px"><%= t.userId ? t.userId.firstName : 'Unknown' %></td>
                <td style="font-size:12px;color:#9CA3AF;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= t.courseId ? t.courseId.title : 'Unknown' %></td>
                <td><strong style="color:#10B981">Rs. <%= t.amount ? t.amount.toLocaleString() : '0' %></strong></td>
              </tr>
              <% }) %>
              <% if (!recentTxns.length) { %>
              <tr><td colspan="3" class="empty-state-sm"><i class="fas fa-coins"></i><p>No payments yet</p></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Platform Info Banner -->
    <div style="background:linear-gradient(135deg,rgba(0,212,255,0.05),rgba(124,58,237,0.05));border:1px solid rgba(0,212,255,0.15);border-radius:16px;padding:20px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px">
      <div style="display:flex;align-items:center;gap:16px">
        <div style="width:44px;height:44px;border-radius:12px;background:rgba(0,212,255,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0">
          <i class="fas fa-graduation-cap" style="color:#00D4FF;font-size:20px"></i>
        </div>
        <div>
          <strong style="font-size:15px;display:block">Learn With Saurab — Nepal's #1 Exam Platform</strong>
          <span style="font-size:12px;color:#6B7280">CEE Medical & BNS · IOE Engineering · Loksewa · License · SEE & NEB</span>
        </div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap">
        <a href="/browse-courses" target="_blank" class="btn-secondary" style="font-size:12px;padding:8px 14px"><i class="fas fa-eye"></i> Live Courses</a>
        <a href="/admin/categories" class="btn-admin-primary" style="font-size:12px;padding:8px 14px"><i class="fas fa-tags"></i> Manage Categories</a>
      </div>
    </div>

  </div>
</div>

<%- include('../partials/footer', { extraJs: `
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const signupData = <%- signupData %>;
const labels = signupData.map(d => d._id);
const counts = signupData.map(d => d.count);
new Chart(document.getElementById('signupChart'), {
  type: 'line',
  data: {
    labels: labels.length ? labels : ['No data'],
    datasets: [{
      label: 'New Students',
      data: counts.length ? counts : [0],
      borderColor: '#00D4FF',
      backgroundColor: 'rgba(0,212,255,0.08)',
      tension: 0.4, fill: true,
      pointBackgroundColor: '#00D4FF',
      pointRadius: 4,
      pointHoverRadius: 6
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        backgroundColor: '#161D2E',
        borderColor: 'rgba(0,212,255,0.3)',
        borderWidth: 1,
        titleColor: '#F9FAFB',
        bodyColor: '#9CA3AF'
      }
    },
    scales: {
      x: { ticks: { color: '#6B7280', font: { size: 11 } }, grid: { color: 'rgba(255,255,255,0.04)' } },
      y: { ticks: { color: '#6B7280', font: { size: 11 } }, grid: { color: 'rgba(255,255,255,0.04)' }, beginAtZero: true }
    }
  }
});
</script>
` }) %>
