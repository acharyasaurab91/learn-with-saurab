<%- include('../partials/header', { extraCss: '<link rel="stylesheet" href="/css/admin.css">' }) %>
<div class="admin-layout">
  <%- include('./partials/sidebar', { activePage: 'categories' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <div>
        <h1><i class="fas fa-tags"></i> Manage Exam Categories</h1>
        <p class="text-muted" style="margin-top:4px">Create, organize and reorder the exam categories shown on the homepage.</p>
      </div>
      <a href="/admin/categories/new" class="btn-admin-primary"><i class="fas fa-plus"></i> Add New Category</a>
    </div>

    <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= flash.success %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= flash.error %></div>
    <% } %>

    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
    <div class="admin-section">
      <p class="text-muted">Toggle visibility instantly, or use the arrows to change homepage order.</p>
      <div class="categories-admin-list" id="catList" style="display:flex;flex-direction:column;gap:10px">
        <% categories.forEach((cat) => { %>
        <div class="cat-admin-row" data-id="<%= cat._id %>" data-order="<%= cat.order %>">
          <span style="width:16px;height:16px;border-radius:50%;background:<%= cat.color %>;flex-shrink:0" title="<%= cat.color %>"></span>
          <div class="cat-icon-preview" style="background: <%= cat.color %>20; color: <%= cat.color %>">
            <i class="<%= cat.icon %>"></i>
          </div>
          <div class="cat-info">
            <strong><%= cat.name %></strong>
            <span class="text-muted" style="font-family:monospace;font-size:11px"><%= cat.slug %></span>
            <% if (cat.description) { %>
              <p class="text-muted" style="margin:4px 0 0"><%= cat.description.slice(0, 60) %><%= cat.description.length > 60 ? '…' : '' %></p>
            <% } %>
            <div class="cat-subjects">
              <% (cat.subjects || []).slice(0, 3).forEach(s => { %><span class="chip-sm"><%= s %></span><% }) %>
              <% if ((cat.subjects || []).length > 3) { %><span class="chip-sm">+<%= cat.subjects.length - 3 %> more</span><% } %>
            </div>
          </div>
          <div class="cat-status">
            <input type="checkbox" class="cat-toggle" data-id="<%= cat._id %>" <%= cat.isVisible ? 'checked' : '' %>
                   title="Visible on homepage" aria-label="Visible on homepage for <%= cat.name %>"
                   style="width:18px;height:18px;accent-color:#0E7C72;cursor:pointer">
          </div>
          <div style="display:flex;align-items:center;gap:6px;flex-shrink:0">
            <span class="text-muted" style="font-weight:700" data-order-num>#<%= cat.order %></span>
            <button type="button" class="btn-icon" style="color:#53616D" onclick="moveCat('<%= cat._id %>', -1)"
                    title="Move up" aria-label="Move <%= cat.name %> up"><i class="fas fa-arrow-up"></i></button>
            <button type="button" class="btn-icon" style="color:#53616D" onclick="moveCat('<%= cat._id %>', 1)"
                    title="Move down" aria-label="Move <%= cat.name %> down"><i class="fas fa-arrow-down"></i></button>
          </div>
          <div class="cat-actions">
            <a href="/admin/categories/<%= cat._id %>/edit" class="btn-icon btn-edit" title="Edit" aria-label="Edit <%= cat.name %>" style="text-decoration:none"><i class="fas fa-edit"></i></a>
            <button type="button" onclick="deleteCat('<%= cat._id %>', '<%= cat.name %>')" class="btn-icon btn-delete" title="Delete" aria-label="Delete <%= cat.name %>"><i class="fas fa-trash"></i></button>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } else { %>
    <div class="admin-section">
      <div class="empty-state-sm">
        <i class="fas fa-tags"></i>
        <p>No categories yet. <a href="/admin/categories/new" style="color:#0E7C72;font-weight:700">Add your first one →</a></p>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer', { extraJs: `
<script>
// ── Visible toggle (optimistic, revert on error) ──
document.querySelectorAll('.cat-toggle').forEach(function (cb) {
  cb.addEventListener('change', async function () {
    var wasChecked = cb.checked;
    try {
      var res = await fetch('/admin/categories/' + cb.dataset.id + '/toggle', { method: 'POST' });
      if (!res.ok) throw new Error('Request failed');
      var data = await res.json();
      cb.checked = data.isVisible;
    } catch (e) {
      cb.checked = !wasChecked;
      alert('Could not save visibility change. Please try again.');
    }
  });
});

// ── Up / down reorder (optimistic DOM move, single [{id, order}] POST) ──
async function moveCat(id, dir) {
  var list = document.getElementById('catList');
  var row = list.querySelector('[data-id="' + id + '"]');
  if (!row) return;
  var sibling = dir < 0 ? row.previousElementSibling : row.nextElementSibling;
  if (!sibling) return;
  if (dir < 0) list.insertBefore(row, sibling); else list.insertBefore(sibling, row);
  var order = [];
  var rows = list.querySelectorAll('.cat-admin-row');
  for (var i = 0; i < rows.length; i++) {
    order.push({ id: rows[i].dataset.id, order: i });
    rows[i].querySelector('[data-order-num]').textContent = '#' + i;
    rows[i].dataset.order = i;
  }
  try {
    var res = await fetch('/admin/categories/reorder', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ order: order })
    });
    if (!res.ok) throw new Error('Request failed');
    await res.json();
  } catch (e) {
    location.reload();
  }
}

// ── Delete with confirmation ──
async function deleteCat(id, name) {
  if (!confirm('Delete category "' + name + '"? This cannot be undone.')) return;
  try {
    var res = await fetch('/admin/categories/' + id + '/delete', { method: 'POST' });
    if (!res.ok) throw new Error('Request failed');
    location.reload();
  } catch (e) {
    alert('Could not delete category. Please try again.');
  }
}
</script>` }) %>
