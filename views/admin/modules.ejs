<%- include('../partials/header', { extraCss: '<link rel="stylesheet" href="/css/admin.css">' }) %>
<div class="admin-layout">
  <%- include('./partials/sidebar', { activePage: 'courses' }) %>
  <div class="admin-main">
    <div class="admin-topbar">
      <h1><i class="fas fa-layer-group"></i> Module Builder: <span class="text-teal"><%= course.title %></span></h1>
      <div class="topbar-actions">
        <a href="/courses/<%= course._id %>" class="btn-secondary" target="_blank"><i class="fas fa-external-link-alt"></i> Preview</a>
        <a href="/admin/courses" class="btn-secondary"><i class="fas fa-arrow-left"></i> Back to Courses</a>
      </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash && flash.success) { %>
      <div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= flash.success %></div>
    <% } %>
    <% if (typeof flash !== 'undefined' && flash && flash.error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= flash.error %></div>
    <% } %>

    <%
      const totalVideos = modules.reduce((s, m) => s + m.videos.length + (m.videoPath ? 1 : 0), 0);
      const typeIcon = (t) => {
        const x = (t || '').toLowerCase();
        if (x.includes('pdf')) return 'fa-file-pdf';
        if (x.includes('doc')) return 'fa-file-word';
        if (x.includes('video') || x.includes('mp4')) return 'fa-film';
        if (x.includes('link') || x.includes('url')) return 'fa-link';
        if (x.includes('image') || x.includes('png') || x.includes('jpg')) return 'fa-image';
        return 'fa-file';
      };
    %>

    <!-- A) Course summary header -->
    <div class="admin-section course-summary">
      <div class="cs-thumb">
        <% if (course.imageUrl) { %>
          <img src="<%= course.imageUrl %>" alt="<%= course.title %>">
        <% } else { %>
          <i class="fas fa-book-open"></i>
        <% } %>
      </div>
      <div class="cs-info">
        <h2><%= course.title %></h2>
        <div class="cs-meta">
          <span class="badge-blue"><%= course.category || 'No category' %></span>
          <span class="badge-green"><%= course.price === 0 ? 'FREE' : 'Rs. ' + course.price.toLocaleString() %></span>
          <span class="badge-gray"><%= modules.length %> module<%= modules.length === 1 ? '' : 's' %></span>
          <span class="badge-yellow"><%= totalVideos %> video<%= totalVideos === 1 ? '' : 's' %></span>
        </div>
      </div>
      <button type="button" class="btn-admin-primary" onclick="toggleAddModule()"><i class="fas fa-plus"></i> Add Module</button>
    </div>

    <!-- B) Add Module form -->
    <div class="admin-section is-hidden" id="addModuleForm">
      <div class="admin-section-header"><h2><i class="fas fa-plus-circle"></i> New Module</h2></div>
      <form onsubmit="return addModule(event)">
        <div class="form-group">
          <label>Module Title *</label>
          <input type="text" name="title" id="newModuleTitle" required placeholder="e.g. Unit 1 — Introduction to Kinematics">
        </div>
        <div class="form-group">
          <label>Description</label>
          <textarea name="description" rows="2" placeholder="What this module covers..."></textarea>
        </div>
        <div class="inline-form-row">
          <div class="form-group checkbox-form-group">
            <label class="checkbox-label"><input type="checkbox" name="isFreePreview"> Free preview module</label>
          </div>
          <input type="hidden" name="order" value="<%= modules.length + 1 %>">
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-admin-primary"><i class="fas fa-save"></i> Save Module</button>
          <button type="button" class="btn-secondary" onclick="toggleAddModule()">Cancel</button>
        </div>
      </form>
    </div>

    <!-- C) Module cards -->
    <% if (modules.length === 0) { %>
      <div class="admin-section">
        <div class="empty-state-sm"><i class="fas fa-layer-group"></i><p>No modules yet — click <strong>Add Module</strong> to create the first one.</p></div>
      </div>
    <% } else { %>
    <div class="module-cards" id="moduleList">
      <% modules.forEach((mod, i) => { %>
      <div class="module-card" data-id="<%= mod._id %>" data-title="<%= mod.title %>">

        <!-- Card header -->
        <div class="module-card-header">
          <div class="module-number"><%= i + 1 %></div>
          <strong class="module-card-title"><%= mod.title %></strong>
          <span class="badge-<%= mod.isFreePreview ? 'green' : 'yellow' %>"><%= mod.isFreePreview ? 'Free' : 'Premium' %></span>
          <div class="module-card-actions">
            <button type="button" class="btn-icon btn-blue" title="Move up" <%= i === 0 ? 'disabled' : '' %> onclick="moveModule('<%= mod._id %>', -1)"><i class="fas fa-arrow-up"></i></button>
            <button type="button" class="btn-icon btn-blue" title="Move down" <%= i === modules.length - 1 ? 'disabled' : '' %> onclick="moveModule('<%= mod._id %>', 1)"><i class="fas fa-arrow-down"></i></button>
            <button type="button" class="btn-icon btn-edit" title="Edit module" onclick="toggleEdit('<%= mod._id %>')"><i class="fas fa-edit"></i></button>
            <button type="button" class="btn-icon btn-delete" title="Delete module" onclick="deleteModule(this)"><i class="fas fa-trash"></i></button>
            <button type="button" class="btn-icon btn-blue" title="Collapse / expand" onclick="toggleBody('<%= mod._id %>')"><i class="fas fa-chevron-up" id="chev-<%= mod._id %>"></i></button>
          </div>
        </div>

        <!-- Card body -->
        <div class="module-card-body" id="body-<%= mod._id %>">
          <p class="module-desc"><%= mod.description || 'No description yet.' %></p>

          <% if (mod.videoPath) { %>
            <p class="legacy-video-note"><i class="fas fa-film"></i> Uploaded video file: <strong><%= mod.videoFilename || mod.videoPath.split('/').pop() %></strong>
              <span class="badge-<%= mod.isFreePreview ? 'green' : 'yellow' %>"><%= mod.isFreePreview ? 'Free' : 'Premium' %></span>
              <span class="text-muted text-sm">(file upload — managed by the legacy upload flow)</span></p>
          <% } %>

          <!-- Inline edit form -->
          <form class="module-edit-form is-hidden" id="editForm-<%= mod._id %>" onsubmit="return saveEdit(event, '<%= mod._id %>')">
            <div class="form-group">
              <label>Module Title *</label>
              <input type="text" name="title" required value="<%= mod.title %>">
            </div>
            <div class="form-group">
              <label>Description</label>
              <textarea name="description" rows="2"><%= mod.description || '' %></textarea>
            </div>
            <div class="inline-form-row">
              <div class="form-group">
                <label>Order</label>
                <input type="number" name="order" min="1" value="<%= mod.order %>">
              </div>
              <div class="form-actions">
                <button type="submit" class="btn-admin-primary"><i class="fas fa-save"></i> Save</button>
                <button type="button" class="btn-secondary" onclick="toggleEdit('<%= mod._id %>')">Cancel</button>
              </div>
            </div>
          </form>

          <!-- Videos list -->
          <div class="mv-block">
            <div class="mv-head">
              <h4><i class="fas fa-video"></i> Videos (<%= mod.videos.length %>)</h4>
              <button type="button" class="btn-icon btn-edit" title="Add video" onclick="toggleVideoForm('<%= mod._id %>')"><i class="fas fa-plus"></i></button>
            </div>
            <% if (mod.videos.length === 0) { %>
              <p class="text-muted text-sm mv-empty">No videos in this module yet.</p>
            <% } else { %>
              <% mod.videos.forEach((v, vi) => { %>
              <div class="mv-row">
                <span class="mv-num"><%= vi + 1 %></span>
                <div class="mv-info">
                  <strong><%= v.videoTitle %></strong>
                  <div class="mv-meta">
                    <span class="text-muted text-sm"><i class="far fa-clock"></i> <%= v.duration ? v.duration + ' min' : '—' %></span>
                    <span class="badge-<%= v.isFree ? 'green' : 'yellow' %>"><%= v.isFree ? 'Free' : 'Paid' %></span>
                  </div>
                </div>
                <button type="button" class="btn-icon btn-delete" title="Remove video" onclick="deleteVideo('<%= mod._id %>', '<%= v._id %>')"><i class="fas fa-trash"></i></button>
              </div>
              <% }) %>
            <% } %>

            <!-- Add video inline form -->
            <form class="mv-form is-hidden" id="videoForm-<%= mod._id %>" onsubmit="return addVideo(event, '<%= mod._id %>')">
              <div class="inline-form-grid">
                <div class="form-group">
                  <label>Video Title *</label>
                  <input type="text" name="videoTitle" required placeholder="e.g. Lecture 1 — Motion in 1D">
                </div>
                <div class="form-group">
                  <label>Source</label>
                  <div class="mf-toggle" role="radiogroup" aria-label="Video source">
                    <label class="mf-opt"><input type="radio" name="videoSource" value="upload" checked> <i class="fas fa-upload"></i> Upload file</label>
                    <label class="mf-opt"><input type="radio" name="videoSource" value="url"> <i class="fas fa-link"></i> Paste URL</label>
                  </div>
                </div>
                <div class="form-group mf-pane mf-pane-file">
                  <label>Video file</label>
                  <input type="file" name="videoFile" accept=".mp4,.webm,.mov,video/mp4,video/webm,video/quicktime">
                  <small class="mf-hint">MP4, WebM or MOV — max 500 MB</small>
                </div>
                <div class="form-group mf-pane mf-pane-url is-hidden">
                  <label>Video URL / Path *</label>
                  <input type="text" name="videoUrl" placeholder="https://... or uploads/videos/file.mp4">
                </div>
                <div class="form-group">
                  <label>Duration (min)</label>
                  <input type="number" name="duration" min="0" placeholder="e.g. 45">
                </div>
                <div class="form-group checkbox-form-group">
                  <label class="checkbox-label"><input type="checkbox" name="isFree"> Free video</label>
                </div>
              </div>
              <div class="up-progress is-hidden" aria-hidden="true">
                <div class="up-progress-bar"></div>
                <span class="up-progress-pct">0%</span>
              </div>
              <div class="up-error is-hidden" role="alert"></div>
              <div class="form-actions">
                <button type="submit" class="btn-admin-primary"><i class="fas fa-save"></i> Save Video</button>
                <button type="button" class="btn-secondary" onclick="toggleVideoForm('<%= mod._id %>')">Cancel</button>
              </div>
            </form>
          </div>

          <!-- Resources list -->
          <div class="mv-block">
            <div class="mv-head">
              <h4><i class="fas fa-folder-open"></i> Resources (<%= mod.resources.length %>)</h4>
              <button type="button" class="btn-icon btn-edit" title="Add resource" onclick="toggleResourceForm('<%= mod._id %>')"><i class="fas fa-plus"></i></button>
            </div>
            <% if (mod.resources.length === 0) { %>
              <p class="text-muted text-sm mv-empty">No resources in this module yet.</p>
            <% } else { %>
              <% mod.resources.forEach((r, ri) => { %>
              <div class="mv-row">
                <span class="mv-num"><i class="fas <%= typeIcon(r.resourceType) %>"></i></span>
                <div class="mv-info">
                  <strong><%= r.title %></strong>
                  <div class="mv-meta">
                    <span class="text-muted text-sm"><%= r.resourceType || 'file' %></span>
                    <span class="badge-<%= r.isFree ? 'green' : 'yellow' %>"><%= r.isFree ? 'Free' : 'Paid' %></span>
                  </div>
                </div>
                <button type="button" class="btn-icon btn-delete" title="Remove resource" onclick="deleteResource('<%= mod._id %>', '<%= r._id %>')"><i class="fas fa-trash"></i></button>
              </div>
              <% }) %>
            <% } %>

            <!-- Add resource inline form -->
            <form class="mv-form is-hidden" id="resourceForm-<%= mod._id %>" onsubmit="return addResource(event, '<%= mod._id %>')">
              <div class="inline-form-grid">
                <div class="form-group">
                  <label>Resource Title *</label>
                  <input type="text" name="title" required placeholder="e.g. Chapter 1 Notes">
                </div>
                <div class="form-group">
                  <label>Source</label>
                  <div class="mf-toggle" role="radiogroup" aria-label="Resource source">
                    <label class="mf-opt"><input type="radio" name="resSource" value="upload" checked> <i class="fas fa-upload"></i> Upload file</label>
                    <label class="mf-opt"><input type="radio" name="resSource" value="url"> <i class="fas fa-link"></i> Paste URL</label>
                  </div>
                </div>
                <div class="form-group mf-pane mf-pane-file">
                  <label>Resource file</label>
                  <input type="file" name="resourceFile" accept=".pdf,.pptx,.docx,.txt,.zip,.ppt,.doc">
                  <small class="mf-hint">PDF, PPTX, DOCX, TXT or ZIP — max 50 MB</small>
                </div>
                <div class="form-group mf-pane mf-pane-url is-hidden">
                  <label>File URL / Path *</label>
                  <input type="text" name="fileUrl" placeholder="https://... or uploads/resources/file.pdf">
                </div>
                <div class="form-group">
                  <label>Type</label>
                  <input type="text" name="resourceType" placeholder="pdf, doc, link, video...">
                </div>
                <div class="form-group checkbox-form-group">
                  <label class="checkbox-label"><input type="checkbox" name="isFree"> Free resource</label>
                </div>
              </div>
              <div class="up-progress is-hidden" aria-hidden="true">
                <div class="up-progress-bar"></div>
                <span class="up-progress-pct">0%</span>
              </div>
              <div class="up-error is-hidden" role="alert"></div>
              <div class="form-actions">
                <button type="submit" class="btn-admin-primary"><i class="fas fa-save"></i> Save Resource</button>
                <button type="button" class="btn-secondary" onclick="toggleResourceForm('<%= mod._id %>')">Cancel</button>
              </div>
            </form>
          </div>

        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer', { extraJs: `<script>
var BASE = '/admin/courses/${course._id}/modules';

function toggleAddModule() {
  var f = document.getElementById('addModuleForm');
  f.classList.toggle('is-hidden');
  if (!f.classList.contains('is-hidden')) document.getElementById('newModuleTitle').focus();
}
function toggleEl(id) {
  var el = document.getElementById(id);
  if (el) el.classList.toggle('is-hidden');
}
function toggleEdit(mid) { toggleEl('editForm-' + mid); }
function toggleVideoForm(mid) { toggleEl('videoForm-' + mid); }
function toggleResourceForm(mid) { toggleEl('resourceForm-' + mid); }
function toggleBody(mid) {
  var body = document.getElementById('body-' + mid);
  var chev = document.getElementById('chev-' + mid);
  if (!body) return;
  var hidden = body.style.display === 'none';
  body.style.display = hidden ? '' : 'none';
  if (chev) chev.className = hidden ? 'fas fa-chevron-up' : 'fas fa-chevron-down';
}

function formToJson(form) {
  var out = {};
  Array.prototype.forEach.call(form.elements, function (el) {
    if (!el.name) return;
    if (el.type === 'checkbox') { if (el.checked) out[el.name] = 'true'; }
    else if (el.type === 'radio') { if (el.checked) out[el.name] = el.value; }
    else out[el.name] = el.value;
  });
  return out;
}

async function postJson(url, data) {
  var res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data || {})
  });
  var body;
  try { body = await res.json(); } catch (e) { throw new Error('Unexpected server response'); }
  if (!body.success) throw new Error(body.message || 'Request failed');
  return body;
}

async function addModule(e) {
  e.preventDefault();
  var form = e.target;
  try {
    await postJson(BASE, formToJson(form));
    location.reload();
  } catch (err) {
    alert('Could not add module: ' + err.message);
    return false;
  }
}

async function saveEdit(e, mid) {
  e.preventDefault();
  try {
    await postJson(BASE + '/' + mid + '/edit', formToJson(e.target));
    location.reload();
  } catch (err) {
    alert('Could not save module: ' + err.message);
    return false;
  }
}

function deleteModule(el) {
  if (!confirm('Delete module "' + el.dataset.title + '"? Its videos and resources are removed too.')) return;
  postJson(BASE + '/' + el.dataset.id + '/delete', {})
    .then(function () { location.reload(); })
    .catch(function (err) { alert('Could not delete module: ' + err.message); });
}

async function moveModule(mid, dir) {
  var list = document.getElementById('moduleList');
  if (!list) return;
  var ids = Array.prototype.map.call(list.querySelectorAll('.module-card'), function (c) { return c.dataset.id; });
  var i = ids.indexOf(mid);
  var j = i + dir;
  if (i < 0 || j < 0 || j >= ids.length) return;
  var tmp = ids[i]; ids[i] = ids[j]; ids[j] = tmp;
  try {
    await postJson(BASE + '/reorder', { order: ids });
    location.reload();
  } catch (err) {
    alert('Could not reorder modules: ' + err.message);
  }
}

function addVideo(e, mid) {
  e.preventDefault();
  var form = e.target;
  var errBox = form.querySelector('.up-error');
  errBox.classList.add('is-hidden');
  var upload = (form.querySelector('input[name="videoSource"]:checked') || {}).value === 'upload';
  var fileInput = form.querySelector('input[name="videoFile"]');
  var urlInput = form.querySelector('input[name="videoUrl"]');
  if (upload && !fileInput.files.length) { showFormError(errBox, 'Choose a video file first.'); return false; }
  if (!upload && !urlInput.value.trim()) { showFormError(errBox, 'Video URL is required.'); return false; }
  sendBuilderForm(form, BASE + '/' + mid + '/videos', upload ? ['videoUrl'] : ['videoFile'], function (body) {
    appendBuilderRow(body, 'video');
    form.reset();
    syncBuilderForm(form);
  });
  return false;
}

function deleteVideo(mid, vid) {
  if (!confirm('Remove this video from the module?')) return;
  postJson(BASE + '/' + mid + '/videos/' + vid + '/delete', {})
    .then(function () { location.reload(); })
    .catch(function (err) { alert('Could not remove video: ' + err.message); });
}

function addResource(e, mid) {
  e.preventDefault();
  var form = e.target;
  var errBox = form.querySelector('.up-error');
  errBox.classList.add('is-hidden');
  var upload = (form.querySelector('input[name="resSource"]:checked') || {}).value === 'upload';
  var fileInput = form.querySelector('input[name="resourceFile"]');
  var urlInput = form.querySelector('input[name="fileUrl"]');
  if (upload && !fileInput.files.length) { showFormError(errBox, 'Choose a resource file first.'); return false; }
  if (!upload && !urlInput.value.trim()) { showFormError(errBox, 'Resource file URL is required.'); return false; }
  sendBuilderForm(form, BASE + '/' + mid + '/resources', upload ? ['fileUrl'] : ['resourceFile'], function (body) {
    appendBuilderRow(body, 'resource');
    form.reset();
    syncBuilderForm(form);
  });
  return false;
}

// ── Phase 6B: upload-file ⇄ paste-URL toggle, XHR progress, inline errors ──
function showFormError(box, msg) {
  box.textContent = msg;
  box.classList.remove('is-hidden');
}

function applyBuilderPanes(form) {
  var checked = form.querySelector('.mf-toggle input[type="radio"]:checked');
  var upload = !!checked && checked.value === 'upload';
  var filePane = form.querySelector('.mf-pane-file');
  var urlPane = form.querySelector('.mf-pane-url');
  if (filePane) filePane.classList.toggle('is-hidden', !upload);
  if (urlPane) urlPane.classList.toggle('is-hidden', upload);
  var fileInput = form.querySelector('input[type="file"]');
  var urlInput = urlPane ? urlPane.querySelector('input[type="text"]') : null;
  if (fileInput) fileInput.disabled = !upload;
  if (urlInput) { urlInput.disabled = upload; urlInput.required = !upload; }
}

function syncBuilderForm(form) {
  if (form.dataset.mfBound !== '1') {
    form.dataset.mfBound = '1';
    Array.prototype.forEach.call(form.querySelectorAll('.mf-toggle input[type="radio"]'), function (r) {
      r.addEventListener('change', function () { applyBuilderPanes(form); });
    });
  }
  applyBuilderPanes(form);
}

function sendBuilderForm(form, url, dropKeys, onSuccess) {
  var errBox = form.querySelector('.up-error');
  var prog = form.querySelector('.up-progress');
  var bar = prog.querySelector('.up-progress-bar');
  var pct = prog.querySelector('.up-progress-pct');
  var btn = form.querySelector('button[type="submit"]');
  var data = new FormData(form);
  data.delete('videoSource');
  data.delete('resSource');
  dropKeys.forEach(function (k) { data.delete(k); });
  btn.disabled = true;
  prog.classList.remove('is-hidden');
  bar.style.width = '0%';
  pct.textContent = '0%';
  var xhr = new XMLHttpRequest();
  xhr.open('POST', url);
  xhr.upload.addEventListener('progress', function (ev) {
    if (ev.lengthComputable) {
      var p = Math.round((ev.loaded / ev.total) * 100);
      bar.style.width = p + '%';
      pct.textContent = p + '%';
    }
  });
  function done() { btn.disabled = false; prog.classList.add('is-hidden'); }
  xhr.addEventListener('load', function () {
    done();
    var body = null;
    try { body = JSON.parse(xhr.responseText); } catch (err) { /* non-JSON */ }
    if (xhr.status >= 200 && xhr.status < 300 && body && body.success) onSuccess(body);
    else showFormError(errBox, (body && body.message) || ('Upload failed (HTTP ' + xhr.status + ').'));
  });
  xhr.addEventListener('error', function () {
    done();
    showFormError(errBox, 'Network error — please try again.');
  });
  xhr.send(data);
}

// Append the freshly-saved entry to the list without a page reload
function appendBuilderRow(body, kind) {
  var mod = body.module;
  var form = document.getElementById((kind === 'video' ? 'videoForm-' : 'resourceForm-') + mod._id);
  if (!form || !form.parentNode) { location.reload(); return; }
  var block = form.parentNode;
  var empty = block.querySelector('.mv-empty');
  if (empty) empty.parentNode.removeChild(empty);
  var items = kind === 'video' ? mod.videos : mod.resources;
  var item = items[items.length - 1];
  var row = document.createElement('div');
  row.className = 'mv-row';
  var num = document.createElement('span');
  num.className = 'mv-num';
  var info = document.createElement('div');
  info.className = 'mv-info';
  var name = document.createElement('strong');
  var meta = document.createElement('div');
  meta.className = 'mv-meta';
  var badge = document.createElement('span');
  badge.className = item.isFree ? 'badge-green' : 'badge-yellow';
  badge.textContent = item.isFree ? 'Free' : 'Paid';
  if (kind === 'video') {
    num.textContent = items.length;
    name.textContent = item.videoTitle;
    var dur = document.createElement('span');
    dur.className = 'text-muted text-sm';
    dur.innerHTML = '<i class="far fa-clock"></i> ';   // static icon markup only
    dur.appendChild(document.createTextNode(item.duration ? item.duration + ' min' : '—'));
    meta.appendChild(dur);
  } else {
    num.innerHTML = '<i class="fas ' + resTypeIcon(item.resourceType) + '"></i>';  // fixed allowlist below
    name.textContent = item.title;
    var type = document.createElement('span');
    type.className = 'text-muted text-sm';
    type.textContent = item.resourceType || 'file';
    meta.appendChild(type);
  }
  meta.appendChild(badge);
  info.appendChild(name);
  info.appendChild(meta);
  var del = document.createElement('button');
  del.type = 'button';
  del.className = 'btn-icon btn-delete';
  del.title = kind === 'video' ? 'Remove video' : 'Remove resource';
  del.innerHTML = '<i class="fas fa-trash"></i>';
  del.addEventListener('click', function () {
    if (kind === 'video') deleteVideo(mod._id, item._id);
    else deleteResource(mod._id, item._id);
  });
  row.appendChild(num);
  row.appendChild(info);
  row.appendChild(del);
  block.insertBefore(row, form);
}

// Mirrors the EJS typeIcon() helper; only fixed class names are returned
function resTypeIcon(t) {
  var x = String(t || '').toLowerCase();
  if (x.indexOf('pdf') >= 0) return 'fa-file-pdf';
  if (x.indexOf('doc') >= 0) return 'fa-file-word';
  if (x.indexOf('video') >= 0 || x.indexOf('mp4') >= 0) return 'fa-film';
  if (x.indexOf('link') >= 0 || x.indexOf('url') >= 0) return 'fa-link';
  if (x.indexOf('image') >= 0 || x.indexOf('png') >= 0 || x.indexOf('jpg') >= 0) return 'fa-image';
  return 'fa-file';
}

