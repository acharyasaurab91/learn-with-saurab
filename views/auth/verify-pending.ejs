<%- include('../partials/header') %>
<div class="auth-page">
  <div class="auth-bg"><div class="auth-orb auth-orb-1"></div><div class="auth-orb auth-orb-2"></div></div>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header" style="text-align:center">
        <a href="/" class="auth-logo"><i class="fas fa-graduation-cap"></i><span>Learn With Saurab</span></a>
        <h1>Check Your Email</h1>
        <p>We sent a verification link to your inbox</p>
      </div>
      <% if (msg) { %><div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= msg %></div><% } %>
      <% if (error) { %><div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div><% } %>
      <div style="text-align:center;padding:18px 0 6px 0">
        <i class="fas fa-envelope-open-text" style="font-size:44px;color:#0E7C72;display:block;margin-bottom:14px"></i>
        <% if (email) { %>
          <p style="font-size:15px;line-height:1.7;color:#3D4A54;margin:0 0 8px 0">A verification link has been sent to<br><strong><%= email %></strong></p>
        <% } else { %>
          <p style="font-size:15px;line-height:1.7;color:#3D4A54;margin:0 0 8px 0">If an account exists for your email, a verification link is on its way.</p>
        <% } %>
        <p style="font-size:13px;line-height:1.6;color:#5F6C76;margin:0">The link expires in <strong>24 hours</strong>. Don&rsquo;t see it? Check your spam folder.</p>
      </div>
      <form action="/resend-verification" method="POST" class="auth-form">
        <button type="submit" class="btn-auth"><span>Resend verification email</span><i class="fas fa-paper-plane"></i></button>
      </form>
      <div class="auth-footer"><a href="/login"><i class="fas fa-arrow-left"></i> Back to Login</a></div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
