<%- include('partials/header') %>

<section class="hero" id="hero">
  <div class="hero-content">
    <div class="hero-badge" data-gsap="fade-up" data-delay="0">
      <span class="badge-dot"></span>
      <span>Nepal's #1 Exam Preparation Platform</span>
    </div>
    <h1 class="hero-title" data-gsap="fade-up" data-delay="0.1">
      <span class="hero-line">Crack CEE, IOE &amp;</span>
      <span class="hero-line">Medical License</span>
      <span class="hero-line">With Confidence</span>
    </h1>
    <p class="hero-desc" data-gsap="fade-up" data-delay="0.3">
      Expert-crafted courses for <strong>CEE Medical &amp; BNS · IOE Engineering · Loksewa · License · SEE &amp; NEB</strong> —
      Video lessons · Practice tests · Smart Weakness Analyzer.
    </p>
    <div class="hero-cta" data-gsap="fade-up" data-delay="0.5">
      <a href="/browse-courses" class="btn-hero-primary">
        <span>Explore Courses</span>
        <i class="fas fa-arrow-right"></i>
      </a>
      <a href="/free-tests" class="btn-hero-outline">
        <span>Try Free Tests</span>
        <i class="fas fa-flask"></i>
      </a>
    </div>
    <div class="hero-stats" data-gsap="fade-up" data-delay="0.7">
      <div class="hero-stat">
        <span class="stat-num" data-target="10000">10,000</span><span>+</span>
        <span class="stat-label">Students</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="stat-num" data-target="500">500</span><span>+</span>
        <span class="stat-label">Video Lessons</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="stat-num" data-target="95">95</span><span>%</span>
        <span class="stat-label">Pass Rate</span>
      </div>
      <div class="hero-stat-divider"></div>
      <div class="hero-stat">
        <span class="stat-num" data-target="6">6</span><span>+</span>
        <span class="stat-label">Exam Categories</span>
      </div>
    </div>
  </div>
</section>

<!-- ── EXAM CATEGORY CARDS ── -->
<section class="categories-section" id="categories">
  <div class="container">
    <div class="section-header" data-gsap="fade-up">
      <span class="section-tag">What We Offer</span>
      <h2 class="section-title">Choose Your <span class="gradient-text">Exam Category</span></h2>
      <p class="section-desc">Specialized preparation programs designed by expert educators for Nepal's most competitive exams</p>
    </div>
    <div class="categories-grid" id="categoriesGrid">
      <% if (categories && categories.length > 0) { %>
        <% categories.filter(c => c.isVisible !== false).forEach((cat, i) => { %>
        <div class="category-card" data-delay="<%= i * 0.1 %>" style="--card-color: <%= cat.color %>">
          <div class="card-inner">
            <div class="card-icon-wrap">
              <div class="card-icon-bg" style="background: <%= cat.color %>1F; color: <%= cat.color %>">
                <i class="<%= cat.icon %>"></i>
              </div>
            </div>
            <h3 class="card-title"><%= cat.name %></h3>
            <p class="card-desc"><%= cat.description || '' %></p>
            <% if (cat.subjects && cat.subjects.length > 0) { %>
            <div class="subject-chips">
              <% cat.subjects.slice(0, 5).forEach(s => { %>
                <span class="chip" style="border-color: <%= cat.color %>33"><%= s %></span>
              <% }) %>
              <% if (cat.subjects.length > 5) { %><span class="chip chip-more">+<%= cat.subjects.length - 5 %> more</span><% } %>
            </div>
            <% } %>
            <a href="/browse-courses?category=<%= cat.slug %>" class="card-cta">
              View Courses <i class="fas fa-chevron-right"></i>
            </a>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <%
          const defaultCats = [
            { name: 'CEE — Medical & Paramedical', icon: 'fas fa-stethoscope', color: '#0E7C72', desc: 'MBBS · BDS · BSc Nursing · B.Pharmacy · Paramedic — pick your target program inside the course', subjects: ['Biology', 'Chemistry', 'Physics', 'English'], slug: 'cee-medical' },
            { name: 'CEE — BNS (B.N.Sc.)', icon: 'fas fa-heart-pulse', color: '#2F7D6C', desc: 'Bachelor of Nursing Science — a separate CEE entrance exam (Biology, Chemistry, Physics)', subjects: ['Biology', 'Chemistry', 'Physics'], slug: 'cee-bns' },
            { name: 'IOE — Engineering', icon: 'fas fa-microchip', color: '#3A6A8A', desc: 'Institute of Engineering entrance — BE, B.Arch, BEI programs', subjects: ['Mathematics', 'Physics', 'Chemistry', 'English'], slug: 'ioe-engineering' },
            { name: 'Loksewa / लोकसेवा', icon: 'fas fa-landmark', color: '#B9852D', desc: 'Nepal Public Service Commission — all levels and services', subjects: ['GK / सामान्य ज्ञान', 'Current Affairs', 'IQ / Reasoning', 'Nepal Constitution'], slug: 'loksewa' },
            { name: 'License Exams', icon: 'fas fa-id-card', color: '#A14A4A', desc: 'Professional license exams: Nursing (NNC), CMLT, Pharmacy (NPC), HA (NHPC)', subjects: ['Nursing License (NNC)', 'CMLT License (NHPC)', 'Pharmacy License (NPC)', 'HA License (NHPC)'], slug: 'license' },
            { name: 'SEE, Grade 11 & 12', icon: 'fas fa-school', color: '#4A6B5A', desc: 'SEE (Grade 10), Grade 11 & Grade 12 — Science & Management streams', subjects: ['SEE — Grade 10', 'Grade 11', 'Grade 12'], slug: 'see-neb' }
          ];
        %>
        <% defaultCats.forEach((cat, i) => { %>
        <div class="category-card" data-delay="<%= i * 0.1 %>" style="--card-color: <%= cat.color %>">
          <div class="card-inner">
            <div class="card-icon-wrap">
              <div class="card-icon-bg" style="background: <%= cat.color %>1F; color: <%= cat.color %>">
                <i class="<%= cat.icon %>"></i>
              </div>
            </div>
            <h3 class="card-title"><%= cat.name %></h3>
            <p class="card-desc"><%= cat.desc %></p>
            <div class="subject-chips">
              <% cat.subjects.forEach(s => { %>
                <span class="chip" style="border-color: <%= cat.color %>33"><%= s %></span>
              <% }) %>
            </div>
            <a href="/browse-courses?category=<%= cat.slug %>" class="card-cta">
              View Courses <i class="fas fa-chevron-right"></i>
            </a>
          </div>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</section>

<!-- ── DEMO LECTURES ── -->
<% if (typeof demoCourses !== 'undefined' && demoCourses && demoCourses.length > 0) { %>
<section class="demo-section">
  <div class="container">
    <div class="section-header" data-gsap="fade-up">
      <span class="section-tag">Free Preview</span>
      <h2 class="section-title">Watch <span class="gradient-text">Demo Lectures</span></h2>
      <p class="section-desc">Watch free sample lessons before enrolling — no login required</p>
    </div>
    <div class="courses-grid courses-grid-wide">
      <% demoCourses.forEach((course, i) => { %>
      <div class="demo-lecture-card" data-gsap="fade-up" data-delay="<%= (i % 3) * 0.1 %>">
        <div class="demo-thumb-wrap">
          <% if (course.imageUrl) { %>
            <img src="<%= course.imageUrl %>" alt="<%= course.title %>" loading="lazy">
          <% } else { %>
            <div class="course-img-placeholder"><i class="fas fa-play-circle"></i></div>
          <% } %>
          <div class="demo-play-btn"><i class="fas fa-play"></i></div>
          <div class="course-badge"><%= course.category || 'Demo' %></div>
        </div>
        <div class="course-body">
          <h3 class="course-title"><%= course.demoTitle || course.title %></h3>
          <p class="course-desc" style="font-size:13px;color:var(--text-muted)"><%= (course.description || '').substring(0, 80) %>...</p>
          <a href="/courses/<%= course._id %>#demo" class="btn-enroll" style="width:100%;justify-content:center;margin-top:8px">
            <span>Watch Free Demo</span><i class="fas fa-play"></i>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- ── WHY CHOOSE US ── -->
<section class="features-section">
  <div class="container">
    <div class="section-header" data-gsap="fade-up">
      <span class="section-tag">Why Choose Us</span>
      <h2 class="section-title">Everything You Need to <span class="gradient-text">Succeed</span></h2>
    </div>
    <div class="features-grid">
      <% [
        { icon: 'fas fa-video', color: '#0E7C72', title: 'HD Video Lessons', desc: 'Crystal-clear videos with speed control, notes, and full DRM protection — watch on any device' },
        { icon: 'fas fa-flask', color: '#3A6A8A', title: 'Smart Practice Tests', desc: 'Timed tests with negative marking, question navigator, instant solutions, and topic analysis' },
        { icon: 'fas fa-bolt', color: '#B9852D', title: '⚡ Galti Copy — Weakness Tracker', desc: 'Auto-tracks every wrong answer from practice & model exams. Smart quiz on your weak spots.' },
        { icon: 'fas fa-shield-halved', color: '#2F7D6C', title: 'Video Content Protection', desc: 'Dynamic watermarking with your name + email on every paid video — forensic anti-leak tracking' },
        { icon: 'fas fa-chart-line', color: '#3A6A8A', title: 'Progress Analytics', desc: 'Real-time progress dashboard with charts, streaks, exam readiness score, and milestone badges' },
        { icon: 'fas fa-mobile-screen', color: '#0E7C72', title: 'Mobile Optimized', desc: 'Learn on any phone or tablet — fully responsive, fast-loading, works on 2G/3G connections' }
      ].forEach((f, i) => { %>
      <div class="feature-card" data-gsap="fade-up" data-delay="<%= i * 0.1 %>">
        <div class="feature-icon" style="background: <%= f.color %>15; color: <%= f.color %>">
          <i class="<%= f.icon %>"></i>
        </div>
        <h3><%= f.title %></h3>
        <p><%= f.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ── FEATURED COURSES ── -->
<% if (featuredCourses && featuredCourses.length > 0) { %>
<section class="courses-section">
  <div class="container">
    <div class="section-header" data-gsap="fade-up">
      <span class="section-tag">Top Picks</span>
      <h2 class="section-title">Featured <span class="gradient-text">Courses</span></h2>
    </div>
    <div class="courses-grid">
      <% featuredCourses.forEach((course, i) => { %>
      <div class="course-card" data-gsap="fade-up" data-delay="<%= i * 0.1 %>">
        <div class="course-img-wrap">
          <% if (course.imageUrl) { %>
            <img src="<%= course.imageUrl %>" alt="<%= course.title %>" loading="lazy">
          <% } else { %>
            <div class="course-img-placeholder"><i class="fas fa-book-open"></i></div>
          <% } %>
          <div class="course-badge"><%= course.category %></div>
          <div class="course-featured-badge"><i class="fas fa-star"></i> Featured</div>
        </div>
        <div class="course-body">
          <h3 class="course-title"><%= course.title %></h3>
          <p class="course-desc"><%= course.description.substring(0, 90) %>...</p>
          <div class="course-meta">
            <% if (course.examType) { %><span><i class="fas fa-layer-group"></i> <%= course.examType %></span><% } %>
            <span><i class="fas fa-users"></i> <%= course.enrolledCount || 0 %> enrolled</span>
          </div>
          <% if (course.targetPrograms && course.targetPrograms.length > 0) { %>
          <div class="course-meta" style="margin-top:-8px">
            <span style="color:var(--brand);font-size:11px"><i class="fas fa-tags"></i> <%= course.targetPrograms.join(' · ') %></span>
          </div>
          <% } %>
          <div class="course-footer">
            <div class="course-price">
              <% if (course.price === 0) { %>
                <span class="price-free">FREE</span>
              <% } else { %>
                <span class="price-amount">Rs. <%= course.price.toLocaleString() %></span>
              <% } %>
            </div>
            <a href="/courses/<%= course._id %>" class="btn-enroll">
              <span>View Course</span>
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
    <div class="section-cta" data-gsap="fade-up">
      <a href="/browse-courses" class="btn-hero-primary">
        <span>View All Courses</span>
        <i class="fas fa-th-large"></i>
      </a>
    </div>
  </div>
</section>
<% } %>

<!-- ── TESTIMONIALS ── -->
<section class="testimonials-section">
  <div class="container">
    <div class="section-header" data-gsap="fade-up">
      <span class="section-tag">Success Stories</span>
      <h2 class="section-title">Students Who <span class="gradient-text">Made It</span></h2>
    </div>
    <div class="testimonials-grid">
      <% [
        { name: 'Aarav Sharma', exam: 'CEE 2081 – MBBS', text: 'The Weakness Analyzer literally found my Chemistry blind spots. Cleared CEE with 89%! Saurab Sir\'s explanations are unmatched.', score: '89%', avatar: 'A' },
        { name: 'Priya Karki', exam: 'Loksewa — Section Officer', text: 'The IQ/Reasoning video lessons and mock tests were exactly like the real PSC exam. Passed on my first attempt!', score: 'Passed', avatar: 'P' },
        { name: 'Bikash Thapa', exam: 'Nursing License (NNC) 2081', text: 'Best platform in Nepal for license prep. Video watermarking, clear explanations, practice tests — everything is perfect.', score: '92%', avatar: 'B' },
        { name: 'Sita Adhikari', exam: 'IOE – BE Computer', text: 'IOE Math and Physics videos were crystal clear. Saurab Sir makes complex topics so easy. Cleared IOE with good rank!', score: 'Cleared', avatar: 'S' },
        { name: 'Ram Thapa', exam: 'CEE BNS 2081', text: 'BNS preparation was so focused. Biology, Chemistry, Physics — all covered in detail. Got through on first attempt!', score: 'Passed', avatar: 'R' },
        { name: 'Anita Gurung', exam: 'CMLT License (NHPC)', text: 'The CMLT license course covered every topic from the official NHPC syllabus. Highly recommended!', score: '88%', avatar: 'A' }
      ].forEach((t, i) => { %>
      <div class="testimonial-card" data-gsap="fade-up" data-delay="<%= i * 0.1 %>">
        <div class="testimonial-quote"><i class="fas fa-quote-left"></i></div>
        <p class="testimonial-text"><%= t.text %></p>
        <div class="testimonial-author">
          <div class="testimonial-avatar"><%= t.avatar %></div>
          <div>
            <strong><%= t.name %></strong>
            <span><%= t.exam %></span>
          </div>
          <div class="testimonial-score"><%= t.score %></div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ── FINAL CTA ── -->
<section class="cta-section">
  <div class="container">
    <div class="cta-content" data-gsap="fade-up">
      <h2>Ready to Start Your <span class="gradient-text">Success Journey?</span></h2>
      <p>Join 10,000+ students already preparing with Nepal's most advanced exam platform</p>
      <div class="cta-buttons">
        <a href="/signup" class="btn-hero-primary">
          <span>Create Free Account</span>
          <i class="fas fa-user-plus"></i>
        </a>
        <a href="/browse-courses" class="btn-hero-outline">
          <span>Browse Courses</span>
          <i class="fas fa-search"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer', { extraJs: `
<script src="/js/content-protection.js"></script>
` }) %>
